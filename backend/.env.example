OPENAI_API_KEY=                        # Optional — OpenAI GPT-4o-mini
GEMINI_API_KEY=sk-your-gemini-key-here # Optional — Gemini 2.5 Flash (preferred)
GEMINI_MODEL=gemini-2.5-flash          # Model to use (gemini-2.5-flash or gemini-2.5-pro)
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=                          # Optional — Neon Postgres pooled URL; enables auth (register/login)
JWT_SECRET=                            # Required in prod when DATABASE_URL is set — long random string
GROQ_API_KEY=                      # Optional — free LLM fallback (Groq) for AI Insights/SWOT
GROQ_MODEL=openai/gpt-oss-120b # Optional — override the Groq model
KOTAK_CONSUMER_KEY=                     # Optional — Kotak Neo Trade API token (FnO desk option chains)
KOTAK_ENVIRONMENT=prod                  # Kotak Neo environment
